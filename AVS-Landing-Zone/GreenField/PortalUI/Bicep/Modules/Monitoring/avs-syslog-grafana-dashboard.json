      "title": "Emergency (emerg)",
      "type": "stat",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "AVSSyslog\n| where \"*\" in ($host) or HostName in ($host)\n| where severity == \"emerg\"\n| summarize Count = count()",
            "resources": ["$workspace"]
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
